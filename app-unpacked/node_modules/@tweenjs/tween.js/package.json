{
  "name": "@tweenjs/tween.js",
  "description": "Simple and fast tweening engine with optimised Robert Penner's equations.",
  "version": "23.1.3",
  "type": "module",
  "main": "dist/tween.cjs",
  "types": "dist/tween.d.ts",
  "module": "dist/tween.esm.js",
  "exports": {
    ".": {
      "import": "./dist/tween.esm.js",
